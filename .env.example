# ==============================================================================
# 🇦🇿 ERPNext Azərbaycan - Konfiqurasiya Parametrləri (.env)
# ==============================================================================
# Bu fayl ERPNext sisteminin bütün qlobal parametrlərini idarə edir.
# İstədiyiniz parametrləri dəyişə və ya standart saxlaya bilərsiniz.
# Əgər hər hansı parametr boş qoyularsa, sistem avtomatik standart dəyəri tətbiq edəcək.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ŞƏBƏKƏ VƏ GİRİŞ PARAMETRLƏRİ (NETWORK & WEB INTERFACE)
# ------------------------------------------------------------------------------
# ERPNext saytının adı (standart: frontend)
SITE_NAME=frontend

# ERPNext veb panelinin açılacağı port (Məsələn: 8080 və ya 80)
HTTP_PORT=8080

# Administrator istifadəçisinin şifrəsi
ADMIN_PASSWORD=admin

# ------------------------------------------------------------------------------
# 2. VERİLƏNLƏR BAZASI - MARIADB 10.6 (DATABASE SETTINGS)
# ------------------------------------------------------------------------------
# MariaDB verilənlər bazası root şifrəsi (istədiyiniz güclü şifrəni təyin edin)
DB_ROOT_PASSWORD=admin

# MariaDB host və port
DB_HOST=db
DB_PORT=3306

# ------------------------------------------------------------------------------
# 3. ŞİRKƏT REKVİZİTLƏRİ (COMPANY DETAILS)
# ------------------------------------------------------------------------------
# Şirkətinizin rəsmi adı (Məsələn: Şirkətim MMC)
COMPANY_NAME=TEST MMC

# Şirkətin qısa abreviaturası (Hesablar planında hesab kodlarının sonunda görünəcək)
COMPANY_ABBR=TM

# Şirkətin 10 rəqəmli rəsmi VÖEN nömrəsi
COMPANY_TAX_ID=1300000001

# Şirkətin fəaliyyət sahəsi (Distribution, Manufacturing, Services, Retail və s.)
COMPANY_DOMAIN=Distribution

# ------------------------------------------------------------------------------
# 4. PERFORMANS VƏ GUNICORN WORKER SAYI (PERFORMANCE & WORKERS)
# ------------------------------------------------------------------------------
# Gunicorn (Python WSGI) HTTP işçi proseslərinin sayı (Standart: 2)
# Tövsiyə: Kiçik/orta serverlər üçün 2 kifayətdir.
# Yüksək yüklü istehsalat serverlərində (CPU nüvə sayı * 2 + 1) düsturu ilə təyin edin (Məs: 4 və ya 8)
WORKERS=2

# ------------------------------------------------------------------------------
# 5. REGİONAL VƏ VALYUTA STANDARTLARI (LOCALIZATION)
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY=AZN
TIMEZONE=Asia/Baku
COUNTRY=Azerbaijan
